<mujoco model="gen3_lite transparent scene">
    <include file="gen3_lite.xml"/>

    <option timestep="0.002" integrator="implicitfast"/>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3"/>
    </visual>

    <!--Table backgrounds, picked per episode by env.py (textures from sim/make_textures.py)-->
    <asset>
        <texture name="checker_bw" type="2d" builtin="checker" rgb1="0.95 0.95 0.95" rgb2="0.1 0.1 0.1" width="128" height="128"/>
        <texture name="checker_color" type="2d" builtin="checker" rgb1="0.9 0.6 0.1" rgb2="0.1 0.4 0.7" width="128" height="128"/>
        <texture name="stripes_a" type="2d" file="textures/stripes_a.png"/>
        <texture name="stripes_b" type="2d" file="textures/stripes_b.png"/>
        <texture name="wood_light" type="2d" file="textures/wood_light.png"/>
        <texture name="wood_dark" type="2d" file="textures/wood_dark.png"/>
        <texture name="noise_fine" type="2d" file="textures/noise_fine.png"/>
        <texture name="noise_coarse" type="2d" file="textures/noise_coarse.png"/>

        <material name="bg_plain_brown" rgba="0.6 0.4 0.3 1"/>
        <material name="bg_plain_gray" rgba="0.5 0.5 0.52 1"/>
        <material name="bg_glasslike_blue" rgba="0.8 0.9 1 1"/>
        <material name="bg_glasslike_white" rgba="0.95 0.95 0.95 1" specular="0.8" shininess="0.8"/>
        <material name="bg_checker_bw" texture="checker_bw" texrepeat="4 4" texuniform="true"/>
        <material name="bg_checker_color" texture="checker_color" texrepeat="6 6" texuniform="true"/>
        <material name="bg_stripes_a" texture="stripes_a" texrepeat="2 2" texuniform="true"/>
        <material name="bg_stripes_b" texture="stripes_b" texrepeat="2 2" texuniform="true"/>
        <material name="bg_wood_light" texture="wood_light" texrepeat="2 2" texuniform="true"/>
        <material name="bg_wood_dark" texture="wood_dark" texrepeat="2 2" texuniform="true"/>
        <material name="bg_noise_fine" texture="noise_fine" texrepeat="2 2" texuniform="true"/>
        <material name="bg_noise_coarse" texture="noise_coarse" texrepeat="2 2" texuniform="true"/>
    </asset>

    <worldbody>
        <!--Lighting presets (env.py) change these; back and spot are off unless a preset turns them on-->
        <light name="key" pos="0.5 0 2" dir="0 0 -1" directional="true" castshadow="false"/>
        <light name="back" pos="0 0.6 1.2" dir="0.5 -0.5 -0.7" directional="true" castshadow="false" active="false"/>
        <light name="spot" pos="0.45 0 1.3" dir="0 0 -1" cutoff="25" exponent="10" castshadow="false" active="false"/>
        <geom name="floor" type="plane" size="2 2 0.1" rgba="0.55 0.55 0.55 1"/>

        <!--Table in front of the arm-->
        <body name="table" pos="0.45 0 0.01">
            <geom name="table" type="box" size="0.25 0.35 0.01" rgba="0.6 0.4 0.3 1"/>
        </body>

        <!--Transparent glass; liquid has no collision or mass, env.py sets its fill level (hidden when empty)-->
        <body name="glass" pos="0.4 0 0.7">
            <freejoint/>
            <geom name="glass" type="cylinder" size="0.03 0.05" rgba="0.8 0.9 1 0.2" mass="0.15"/>
            <geom name="liquid" type="cylinder" size="0.026 0.001" pos="0 0 -0.049" rgba="0.7 0.85 1 0" contype="0" conaffinity="0" mass="0"/>
        </body>

        <!--Opaque distractors, parked behind the camera (out of view, no contacts, floating) until env.py places them on the table-->
        <body name="dist_mug" gravcomp="1" pos="1.6 -1.6 0.046">
            <freejoint/>
            <geom type="cylinder" size="0.04 0.045" rgba="0.8 0.2 0.2 1" mass="0.2"/>
            <geom type="box" pos="0.05 0 0" size="0.012 0.006 0.025" rgba="0.8 0.2 0.2 1" mass="0.01"/>
        </body>
        <body name="dist_box" gravcomp="1" pos="1.8 -1.6 0.041">
            <freejoint/>
            <geom type="box" size="0.05 0.035 0.04" rgba="0.2 0.3 0.8 1" mass="0.2"/>
        </body>
        <body name="dist_can" gravcomp="1" pos="1.6 -1.8 0.059">
            <freejoint/>
            <geom type="cylinder" size="0.033 0.058" rgba="0.7 0.7 0.75 1" mass="0.2"/>
        </body>
        <body name="dist_bowl" gravcomp="1" pos="1.8 -1.8 0.026">
            <freejoint/>
            <geom type="cylinder" size="0.07 0.025" rgba="0.2 0.6 0.3 1" mass="0.2"/>
            <geom name="dist_bowl_inner" type="cylinder" pos="0 0 0.024" size="0.06 0.002" rgba="0.12 0.36 0.18 1" contype="0" conaffinity="0" mass="0"/>
        </body>
        <body name="dist_bottle" gravcomp="1" pos="1.6 -1.4 0.046">
            <freejoint/>
            <geom type="cylinder" size="0.032 0.045" rgba="0.3 0.5 0.2 1" mass="0.2"/>
            <geom type="cylinder" pos="0 0 0.06" size="0.013 0.015" rgba="0.3 0.5 0.2 1" mass="0.02"/>
        </body>
        <body name="dist_opaque_cup" gravcomp="1" pos="1.8 -1.4 0.051">
            <freejoint/>
            <geom type="cylinder" size="0.03 0.05" rgba="0.9 0.9 0.85 1" mass="0.15"/>
        </body>

        <!--Fixed camera looking at table-->
        <camera name="front_cam" mode="targetbody" target="table" pos="1.0 -0.55 0.9" fovy="60"/>
    </worldbody>

    <actuator>
        <position name="a1" joint="joint_1" kp="100" kv="10" ctrlrange="-2.69 2.69"/>
        <position name="a2" joint="joint_2" kp="100" kv="10" ctrlrange="-2.69 2.69"/>
        <position name="a3" joint="joint_3" kp="100" kv="10" ctrlrange="-2.69 2.69"/>
        <position name="a4" joint="joint_4" kp="50" kv="5" ctrlrange="-2.59 2.59"/>
        <position name="a5" joint="joint_5" kp="50" kv="5" ctrlrange="-2.57 2.57"/>
        <position name="a6" joint="joint_6" kp="50" kv="5" ctrlrange="-2.59 2.59"/>
        <position name="gripper" joint="right_finger_bottom_joint" kp="10" kv="1" ctrlrange="0 0.85"/>
    </actuator>
</mujoco>


